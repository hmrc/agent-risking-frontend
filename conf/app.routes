# microservice specific routes

->         /hmrc-frontend           hmrcfrontend.Routes
GET        /                        uk.gov.hmrc.agentriskingfrontend.controllers.StartController.landing
GET        /assets/*file            controllers.Assets.versioned(path = "/public", file: Asset)

GET       /any-signed-in-page          uk.gov.hmrc.agentriskingfrontend.controllers.StartController.anySignedInPage
# Sign out routes
GET         /sign-out                                                  uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signOut(signBackInUrl: Option[RedirectUrl])
GET         /signed-out                                                uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signedOut(signBackInUrl: RedirectUrl)
GET         /sign-out-with-continue                                    uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signOutWithContinue(continueUrl: RedirectUrl)
GET         /time-out                                                  uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.timeOut(signBackInUrl: RedirectUrl)
GET         /timed-out                                                 uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.timedOut(signBackInUrl: RedirectUrl)

GET         /agent/save-for-later            uk.gov.hmrc.agentriskingfrontend.controllers.agent.SaveForLaterController.show
