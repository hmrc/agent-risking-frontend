# microservice specific routes

->         /hmrc-frontend           hmrcfrontend.Routes
GET        /                        uk.gov.hmrc.agentriskingfrontend.controllers.HelloWorldController.helloWorld
GET        /assets/*file            controllers.Assets.versioned(path = "/public", file: Asset)

# Sign out routes
GET         /sign-out                                                  uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signOut
GET         /signed-out                                                uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signedOut
GET         /sign-out-with-continue                                    uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.signOutWithContinue(continueUrl: RedirectUrl)
GET         /time-out                                                  uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.timeOut(signBackInUrl: Option[RedirectUrl])
GET         /timed-out                                                 uk.gov.hmrc.agentriskingfrontend.controllers.SignOutController.timedOut(signBackInUrl: Option[RedirectUrl])

